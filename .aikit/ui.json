{
  "schema": 1,
  "surfaces": {
    "terminal": {
      "paths": [
        "src/ui.rs"
      ]
    }
  },
  "protected": [
    "tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/__tests__/**"
  ],
  "commands": {
    "fast": "cargo test",
    "snapshot": "",
    "interaction": "",
    "interaction_timeout": 120
  },
  "style": {
    "theme_paths": []
  },
  "limits": {
    "max_files": 12,
    "max_lines": 300,
    "max_added_lines": 200,
    "max_deleted_lines": 100
  },
  "backend_paths": [
    "src/**"
  ]
}